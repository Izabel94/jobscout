# LLM provider — `anthropic` (default) or `gemini`.
# Swap freely; the right SDK is lazy-imported. Match the chosen provider's
# model IDs in `config/profile.yaml` (`model_score`, `model_draft`).
LLM_PROVIDER=anthropic

# Only the key for the active provider needs a real value. Other can stay blank.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=

# Supabase — local CLI stack defaults (run `supabase start` to get real keys)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<from `supabase start` output>
SUPABASE_SERVICE_ROLE_KEY=<from `supabase start` output>

SENTENCE_TRANSFORMERS_HOME=./sentence_transformers_cache
SCRAPER_CONTACT_EMAIL=izabelcvetkovic@gmail.com
UPWORK_SAVED_SEARCH_URLS=
